-- VERIFICACIÓN POST-MIGRACIÓN
-- =============================================================================

-- Verificar que la migración fue exitosa
-- SELECT COUNT(*) AS total_users FROM users;

-- Comparar counts entre esquemas
-- SELECT 
--     (SELECT COUNT(*) FROM growup_backend.users WHERE deleted_at IS NULL AND is_active = true) AS origen_activos,
--     (SELECT COUNT(*) FROM users) AS destino_total;

-- Verificar que no hay emails duplicados
