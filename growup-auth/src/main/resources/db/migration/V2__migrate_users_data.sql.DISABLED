--     password,
--     role::VARCHAR(50),
--     false,                     -- is_active = false para users con deleted_at
--     avatar_url,
--     bio,
--     join_date,
--     COALESCE(version, 0)
-- FROM growup_backend.users
-- WHERE deleted_at IS NOT NULL;

